{
  "name": "candlestack-ops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "types": "wrangler types",
    "check": "wrangler types --check && tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware && prettier --check . && knip"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "knip": "6.44.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
